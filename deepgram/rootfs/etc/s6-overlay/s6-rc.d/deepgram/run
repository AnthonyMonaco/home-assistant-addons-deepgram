#!/command/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start Deepgram service
# ==============================================================================

if ! bashio::config.has_value 'api_key'; then
    bashio::exit.nok "API key is required. Please configure it in the addon settings."
fi

bashio::log.info "Starting Deepgram Wyoming STT server..."
exec python3 /app/deepgram_server.py
